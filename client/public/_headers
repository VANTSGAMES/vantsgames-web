# Cabeceras de cache para Cloudflare Workers Assets.
# HTML y rutas raiz revalidan siempre para reflejar deploys al instante;
# bundles con hash en /assets/* son inmutables (1 año); portadas e insignias
# usan cache moderada con stale-while-revalidate.

/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/insignias/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/brand/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
